<Page
    x:Class="NameCube.ToolBox.AutomaticProcessPages.ProcessSettingPages.ShutDownSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube.ToolBox.AutomaticProcessPages.ProcessSettingPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ShutDownSettingPage"
    d:DesignHeight="420"
    d:DesignWidth="410"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="关机方式" />
            <ComboBox
                x:Name="ShutDownWayComboBox"
                Margin="0,6,0,0"
                HorizontalAlignment="Stretch"
                SelectionChanged="ShutDownWayComboBox_SelectionChanged">
                <ComboBoxItem Content="立刻关机" IsSelected="True" />
                <ComboBoxItem Content="一般关机" />
                <ComboBoxItem Content="强制关机" />
            </ComboBox>

            <TextBlock
                x:Name="ShutDownWayHintText"
                Margin="2,6,0,0"
                FontSize="12"
                LineHeight="18"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,18,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="全屏提醒内容" />
            <ui:TextBox
                x:Name="RemindTextBox"
                Height="112"
                Margin="0,6,0,0"
                AcceptsReturn="True"
                MaxLength="300"
                PlaceholderText="留空则使用默认提醒"
                TextChanged="RemindTextBox_TextChanged"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="RemindHintText"
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,18,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="倒计时（秒）" />
            <ui:NumberBox
                x:Name="CountdownNumberBox"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Maximum="3600"
                Minimum="5"
                Value="30"
                Width="180"
                ValueChanged="CountdownNumberBox_ValueChanged" />

            <TextBlock
                Margin="0,18,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="触发这个流程时，会自动切换到全屏并显示上面的提醒内容，倒计时结束前可以点击「继续使用电脑」或按 Esc 取消（流程组设置为不可取消时除外）。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="NameCube.ToolBox.AutomaticProcessPages.ProcessPages.PowerOffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube.ToolBox.AutomaticProcessPages.ProcessPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PowerOffPage"
    d:DesignHeight="900"
    d:DesignWidth="1600"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  居中提醒区：全屏触发时铺满整个屏幕  -->
        <StackPanel
            Grid.Row="0"
            MaxWidth="1100"
            Margin="40,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="88"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Symbol="Warning24" />

            <TextBlock
                x:Name="TitleTextBlock"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="60"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="电脑即将关机"
                TextAlignment="Center" />

            <TextBlock
                x:Name="RemindTextBlock"
                MaxWidth="900"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                Margin="0,26,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="CountdownText"
                    VerticalAlignment="Bottom"
                    FontSize="112"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="30" />
                <TextBlock
                    x:Name="CountdownUnitText"
                    Margin="14,0,0,26"
                    VerticalAlignment="Bottom"
                    FontSize="30"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="秒后自动关机" />
            </StackPanel>

            <ProgressBar
                x:Name="CountdownProgress"
                Width="660"
                Height="8"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Maximum="100"
                Minimum="0"
                Value="100" />

            <TextBlock
                x:Name="StatusText"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="" />

            <StackPanel
                Margin="0,34,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="CancelButton"
                    MinWidth="300"
                    Padding="34,16"
                    Appearance="Primary"
                    Click="Button_Click"
                    FontSize="24"
                    Icon="{ui:SymbolIcon Symbol=ArrowCircleRight24,
                                         FontSize=26}">
                    <Run Text="继续使用电脑" />
                </ui:Button>

                <ui:Button
                    x:Name="PowerOffButton"
                    MinWidth="300"
                    Margin="22,0,0,0"
                    Padding="34,16"
                    Appearance="Danger"
                    Click="PowerOffButton_Click"
                    FontSize="24"
                    Icon="{ui:SymbolIcon Symbol=Power24,
                                         FontSize=26}">
                    <Run Text="立即关机" />
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <TextBlock
            x:Name="FootText"
            Grid.Row="1"
            Margin="0,0,0,26"
            HorizontalAlignment="Center"
            FontSize="15"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text=""
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </Grid>
</Page>

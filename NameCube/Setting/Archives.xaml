<Page
    x:Class="NameCube.Setting.Archives"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Archives"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar
            Grid.Row="0"
            Margin="4,0,4,4"
            Title="建议"
            IsClosable="False"
            IsOpen="True"
            Message="名字尽量不要超过5个字，可能会导致显示不全" />
        <ui:InfoBar
            x:Name="WarningInfoBar"
            Grid.Row="1"
            Margin="4,0,4,4"
            Title="警告"
            Message="数量尽量不要超过120个，可能会导致卡顿"
            Severity="Warning" />

        <ui:CardControl
            Grid.Row="2"
            Margin="4"
            Padding="20,12,20,12"
            Icon="{ui:SymbolIcon Symbol=PeopleCommunity24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock
                        Margin="0"
                        FontTypography="BodyStrong"
                        Text="学生名单"
                        TextWrapping="WrapWithOverflow" />
                    <ui:TextBlock
                        x:Name="NameCountText"
                        Appearance="Secondary"
                        Text="共 0 个名字"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel MinWidth="420" HorizontalAlignment="Right">
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button
                        x:Name="BulkAddButton"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="BulkAddButton_Click"
                        Content="批量添加"
                        Icon="{ui:SymbolIcon Symbol=Add24}"
                        ToolTip="一次粘贴多个名字，一行一个，重复的会自动跳过" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="Button_Click"
                        Content="从文本文档导入"
                        Icon="{ui:SymbolIcon Symbol=DocumentArrowUp20}"
                        ToolTip="选择一个 txt 文件，用文件里的名字替换当前名单" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="Button_Click_4"
                        Content="使用示例名单"
                        Icon="{ui:SymbolIcon Symbol=PeopleCommunity24}"
                        ToolTip="用 40 个示例姓名替换当前名单" />
                    <ui:Button
                        x:Name="ClearButton"
                        Click="ClearButton_Click"
                        Content="清空"
                        Icon="{ui:SymbolIcon Symbol=Broom24}"
                        ToolTip="清空当前名单" />
                </WrapPanel>
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:TextBox
                        x:Name="AddNameTextBox"
                        Width="180"
                        KeyDown="AddNameTextBox_KeyDown"
                        PlaceholderText="输入一个名字，回车添加"
                        Unloaded="AddNameTextBox_Unloaded" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="Button_Click_1"
                        Content="添加"
                        Icon="{ui:SymbolIcon Symbol=Add16}" />
                </StackPanel>
            </StackPanel>
        </ui:CardControl>

        <Grid Grid.Row="3" Margin="4,0,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBox
                x:Name="FilterTextBox"
                Width="200"
                Margin="0,0,10,6"
                HorizontalAlignment="Right"
                PlaceholderText="搜索名字..."
                TextChanged="FilterTextBox_TextChanged" />
            <ui:DataGrid
                x:Name="DataGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding AllNames}"
                RowHeight="44">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="姓名" />
                    <DataGridTemplateColumn Width="110" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button
                                    HorizontalAlignment="Center"
                                    Click="Button_Click_3"
                                    CommandParameter="{Binding}"
                                    Content="删除"
                                    Icon="{ui:SymbolIcon Symbol=Delete24}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
            <ui:TextBlock
                x:Name="EmptyHint"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Appearance="Secondary"
                IsHitTestVisible="False"
                Text="名单还是空的，点上方「批量添加」可以一次粘贴多个名字"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>

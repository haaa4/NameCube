<Page
    x:Class="NameCube.Setting.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About"
    d:DesignHeight="800"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFont}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <ui:Image
                Height="auto"
                Margin="12"
                MouseDown="Image_MouseDown"
                Source="pack://application:,,,/Image/海报.png" />
            <Expander Margin="12,0,12,0">
                <Expander.Header>
                    <StackPanel>
                        <ui:Image
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Left"
                            Source="pack://application:,,,/icon.png" />
                        <TextBlock FontSize="30" Text="点鸣魔方 NameCube" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="VersionTextBlock" />
                    <TextBlock Text="作者:哈阿斯" />
                    <TextBlock Text="默认名单所有名字均为Ai生成，如侵请联系作者，立刻删除" />
                    <TextBlock Text="Copyright (C) 2025-2026 haaa4" />
                    <TextBlock Foreground="Brown"  Text="记忆是梦的开场白" />
                </StackPanel>
            </Expander>
            <Expander Margin="12,0">
                <Expander.Header>
                    <TextBlock>
                        <Run FontSize="30" Text="关于作者" />
                    </TextBlock>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="HeadImage"
                        Width="100"
                        Height="100"
                        Margin="20" />
                    <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap">
                            <Run FontSize="30" Text="哈阿斯（haaa4)" />
                            <Run FontSize="20" Text="   因为祂永远不会放弃你，永远不会令你沮丧，永远不会抛弃你，永远不会让你哭，永远不会同你道别，永远不会用谎言伤害你。" />
                        </TextBlock>
                        <ui:HyperlinkButton
                            Content="作者B站"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://space.bilibili.com/1440486452" />
                        <ui:HyperlinkButton
                            Content="作者Github"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://github.com/haaa4" />
                    </StackPanel>
                </Grid>
            </Expander>
            <Expander Margin="12,0">
                <Expander.Header>
                    <TextBlock>
                            <Run FontSize="30" Text="系列应用" />
                    </TextBlock>
                </Expander.Header>
                <StackPanel>
                    <ui:Card HorizontalAlignment="Stretch">
                        <Grid Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1.5*" />
                            </Grid.RowDefinitions>
                            <Image
                                    x:Name="NameCubeIcon"
                                    Grid.RowSpan="2"
                                    Height="80" 
                                Source="/icon.png"/>
                            <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="NameCube" />
                            <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="点名器-概率或者命中注定？" />
                            <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/NameCube" />
                                <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/NameCube" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card HorizontalAlignment="Stretch">
                        <Grid Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1.5*" />
                            </Grid.RowDefinitions>
                            <Image
                                    Grid.RowSpan="2"
                                    Height="80"
                                x:Name="SeatMapperIcon"
                            />
                            <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="SeatMapper" />
                            <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="生成座位表-基于Excel表格生成座位表" />
                            <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/SeatMapper" />
                                <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/SeatMapper" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card HorizontalAlignment="Stretch">
                        <Grid Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1.5*" />
                            </Grid.RowDefinitions>
                            <Image
                                    Grid.RowSpan="2"
                                    Height="80"
                                    x:Name="DeskSweeperIcon" />
                            <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="DeskSweeper" />
                            <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="文件整理-诶🤓👆🏻，您的桌面上又被下载了一个PPT，让我们的清道夫来帮你整理吧" />
                            <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/DeskSweeper" />
                                <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/DeskSweeper" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </StackPanel>
            </Expander>

            <Expander Margin="12,0">
                <Expander.Header>
                    <TextBlock>
                        <Run FontSize="30" Text="支持库" />
                    </TextBlock>
                </Expander.Header>
                <ui:Button
                    Click="Button_Click"
                    Content="点击查看详细信息"
                    FontSize="20" />
            </Expander>
            <Expander Margin="12,0">
                <Expander.Header>
                    <TextBlock>
                        <Run FontSize="30" Text="其他链接" />
                    </TextBlock>
                </Expander.Header>
                <StackPanel>
                    <ui:HyperlinkButton
                        Content="Github主页"
                        Icon="{ui:SymbolIcon Link24}"
                        NavigateUri="https://github.com/haaa4/NameCube" />
                    <ui:HyperlinkButton
                        Content="Gitee主页"
                        Icon="{ui:SymbolIcon Link24}"
                        NavigateUri="https://gitee.com/haaa4/NameCube" />
                    <ui:HyperlinkButton
                        Content="NameCube Wiki"
                        Icon="{ui:SymbolIcon Link24}"
                        NavigateUri="https://github.com/haaa4/NameCube/wiki" />
                    <ui:HyperlinkButton
                        Content="WPF UI"
                        Icon="{ui:SymbolIcon Link24}"
                        NavigateUri="https://github.com/lepoco/wpfui/tree/main" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </Grid>
</Page>
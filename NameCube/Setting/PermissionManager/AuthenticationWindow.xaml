<ui:FluentWindow
    x:Class="NameCube.Setting.PermissionManager.AuthenticationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube.Setting.PermissionManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="FluentWindow_Loaded"
    Title="认证凭证"
    Width="510"
    Height="280"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">
    <StackPanel Margin="20">
        <ui:TextBlock
            FontSize="26"
            FontWeight="Bold"
            Text="认证凭证" />
        <TextBlock
            Margin="20,10,0,20"
            FontSize="15"
            Text="请输入认证凭证,或者认证U盘凭证后以继续操作" />
        <ui:PasswordBox Margin="20,0" PlaceholderText="输入密码..." x:Name="Password"/>
        <Button
            Margin="20,10"
            Content="正在认证U盘凭证"
            IsEnabled="False" 
            x:Name="btnUsbVerification"
            Click="btnUsbVerification_Click"/>
        <StackPanel Orientation="Horizontal">
            <Button
            Margin="20,10"
            Click="Button_Click"
            Content="确认" />
            <Button
Margin="0,10"
Click="Button2_Click"
Content="取消" />
        </StackPanel>


    </StackPanel>
</ui:FluentWindow>

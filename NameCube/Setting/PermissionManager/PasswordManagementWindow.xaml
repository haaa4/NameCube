<ui:FluentWindow
    x:Class="NameCube.Setting.PermissionManager.PasswordManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NameCube.Setting.PermissionManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="Window_Loaded"
    Title="PasswordManagementWindow"
    Width="382"
    Height="496"
    
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <Storyboard x:Key="Start">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbolIcon" Storyboard.TargetProperty="(ui:FontIcon.FontSize)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="34">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="120">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <ui:TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                FontWeight="Bold"
                Text="密码设置" />
            <ui:SymbolIcon
                x:Name="symbolIcon"
                Grid.Row="1"
                FontSize="120"
                Foreground="#FF005493"
                Symbol="Key24" />
            <ui:TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="Bold"
                Text="   请在周围环境安全的情况下输入密码。记住，这是你唯一恢复的配置文件的方式"
                TextWrapping="Wrap" />
        </Grid>
        <ui:PasswordBox
            Grid.Row="1"
            Margin="20,0"
            x:Name="PasswordBox1"
            PlaceholderText="输入密码..." />
        <ui:PasswordBox
            Grid.Row="2"
            Margin="20,0"
            x:Name="PasswordBox2"
            PlaceholderText="再次输入密码..." />
        <ui:Button
            Grid.Row="3"
            Margin="20,0"
            x:Name="OkButton"
            HorizontalAlignment="Center"
            Click="Button_Click"
            Content="确认" />
    </Grid>
</ui:FluentWindow>

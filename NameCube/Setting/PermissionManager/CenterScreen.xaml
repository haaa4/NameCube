<ui:FluentWindow x:Class="NameCube.Setting.PermissionManager.CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Loaded="FluentWindow_Loaded"
        Title="绑定U盘凭证" Height="350" Width="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Storyboard x:Key="Start">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbolIcon" Storyboard.TargetProperty="(ui:FontIcon.FontSize)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="34">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="100">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </ui:FluentWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请插入要绑定的U盘，以在不输入密码的情况下验证" FontSize="14" Margin="0,0,0,10"/>
                    <ui:SymbolIcon
                x:Name="symbolIcon"
                FontSize="100" Margin="260 0 0 0"
                Foreground="#FF005493"
                Symbol="Key24" />

        <!-- U盘选择 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="选择U盘：" VerticalAlignment="Center" Width="80"/>
            <ComboBox x:Name="cmbUsbDrives" Width="200" Margin="5,0" 
                      DisplayMemberPath="DisplayText" SelectedValuePath="RootPath"/>
            <Button x:Name="btnRefresh" Content="刷新" Width="60" Click="BtnRefresh_Click" Margin="5,0"/>
        </StackPanel>


        <!-- 提示信息 -->
        <TextBlock x:Name="lblStatus" Grid.Row="4" Text="请插入U盘并刷新列表" 
                   Foreground="Gray" Margin="0,10" TextWrapping="Wrap"/>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button x:Name="btnBind" Content="绑定U盘" Width="120" Height="30" 
                    Click="BtnBind_Click" Margin="0,0,20,0"/>
            <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
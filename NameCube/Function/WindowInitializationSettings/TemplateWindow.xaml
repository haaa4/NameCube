<ui:FluentWindow x:Class="NameCube.Function.WindowInitializationSettings.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NameCube.Function.WindowInitializationSettings"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TemplateWindow" Height="700" Width="1400" SizeChanged="FluentWindow_SizeChanged" LocationChanged="FluentWindow_LocationChanged">

    <Grid>
        <ui:TitleBar
    Title="你可以拖拽我来调整位置！也可以在边缘调整大小"
    Grid.Row="0"
            Foreground="Wheat"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False"
    FontSize="20"
            Background="Gray"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text=" 你可以随意移动窗口和调整大小，来让主界面达到合适位置" FontSize="20"/>
            <TextBlock Name="DescriptionTextBlock" FontSize="20"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button Content="保存" Appearance="Primary" Click="Button_Click"/>
                <ui:Button Content="关闭" Click="Button_Click_1"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
